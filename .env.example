# Salin file ini menjadi .env lalu isi dengan nilai asli:
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
# JANGAN commit .env ke git (sudah ada di .gitignore).
#
# Repo ini membawa .env.enc — versi terenkripsi (AES-256) dari .env berisi
# nilai asli. Cara memakainya:
#   openssl enc -d -aes-256-cbc -pbkdf2 -in .env.enc -out .env
#   (minta password dekripsi ke pembimbing / cek worksheet)

# POSTGRES_PASSWORD/DB_PASSWORD tidak dipakai lagi — password DB
# (TopUpDb#2026) sudah langsung di docker-compose.yml.

JWT_SECRET=JWT_SECRET_PLACEHOLDER
API_KEY=API_KEY_PLACEHOLDER
ADMIN_PASSWORD=ADMIN_PASSWORD_PLACEHOLDER
CTF_FLAG=CTF_FLAG_PLACEHOLDER